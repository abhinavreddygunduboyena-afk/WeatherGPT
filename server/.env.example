# ============================================================================
# WeatherGPT Node.js + Express Backend Environment Configuration
# Copy this file to .env inside the server/ directory:
# Windows CMD: copy .env.example .env
# Windows PowerShell: Copy-Item .env.example .env
# ============================================================================

# 1. Server Network Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# 2. Google Gemini API Key (Farmer Intelligence Multilingual Assistant)
# Get a key at: https://aistudio.google.com/
# When omitted, WeatherGPT automatically uses its built-in rule-based Indian Agrometeorology Engine.
GEMINI_API_KEY=

# 3. OpenRouteService API Key (Driving directions, route geometry & duration)
# Get a free key at: https://openrouteservice.org/dev/#/api-docs
# When omitted, WeatherGPT automatically falls back to OpenStreetMap OSRM routing engine.
OPENROUTESERVICE_API_KEY=

# 4. India Meteorological Department (IMD) API Key
# Official registration required at: https://api.imd.gov.in/public/api_reference.html
# When omitted, WeatherGPT reports authorized credentials required by Ministry of Earth Sciences.
IMD_API_KEY=

# 5. BHASHINI National Language Translation Mission API Key (Government of India)
# Register at: https://bhashini.gov.in/
# When omitted, WeatherGPT automatically utilizes the native Web Speech API (Chrome/Edge/Android) for speech recognition & text-to-speech.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# 6. TomTom Traffic Incidents API Key (Live Road Closures, Roadworks & Hazards)
# Register for a free developer account at: https://developer.tomtom.com/
# Free tier offers 2,500 non-tile requests/day (includes India National & State Highway coverage).
# When omitted, WeatherGPT clearly reports the incident feed as unconfigured with zero fake data.
TOMTOM_API_KEY=
