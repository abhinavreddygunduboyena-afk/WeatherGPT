# WeatherGPT Environment Configuration
# Copy this file to .env.local to configure custom services.

# SECURE BACKEND ENVIRONMENT VARIABLES (Never exposed to frontend code or client bundles)
# 1. OpenRouteService API Key (Driving directions, route geometry & duration)
# Get a free key at: https://openrouteservice.org/dev/#/api-docs
# When omitted, WeatherGPT automatically falls back to the open-access OpenStreetMap OSRM routing engine.
OPENROUTESERVICE_API_KEY=

# 2. India Meteorological Department (IMD) API Key
# Official registration required at: https://api.imd.gov.in/public/api_reference.html
# When omitted, WeatherGPT reports authorized credentials required by Ministry of Earth Sciences.
IMD_API_KEY=

# 3. Google Gemini API Key (Multilingual Generative Farmer Intelligence)
# Get a key at: https://aistudio.google.com/
# When omitted, WeatherGPT uses its built-in rule-based Indian Agrometeorology Engine with zero setup.
GEMINI_API_KEY=

# 4. BHASHINI National Language Translation Mission API Key (Government of India)
# Register at: https://bhashini.gov.in/
# When omitted, WeatherGPT automatically utilizes the native Web Speech API (Chrome/Edge/Android) for speech recognition & text-to-speech.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# 5. TomTom Traffic Incidents API Key (Live Road Closures, Roadworks & Hazards)
# Register for a free developer account at: https://developer.tomtom.com/
# Free tier offers 2,500 non-tile requests/day (includes India National & State Highway coverage).
# When omitted, WeatherGPT clearly reports the incident feed as unconfigured with zero fake data.
TOMTOM_API_KEY=

# FRONTEND VARIABLES (Public/Client)
# Supabase credentials for cloud project synchronization
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Weather Provider API (Defaults to free keyless Open-Meteo REST service)
VITE_WEATHER_API_ENDPOINT=https://api.open-meteo.com/v1
VITE_GEOCODING_API_ENDPOINT=https://geocoding-api.open-meteo.com/v1
